.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 列表 */
.list-header {
  padding: 32rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.content-list {
  padding: 0 32rpx;
}

.content-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.status-completed {
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
}

.status-processing {
  color: #667eea;
  background-color: rgba(102, 126, 234, 0.1);
}

.status-pending {
  color: #f5a623;
  background-color: rgba(245, 166, 35, 0.1);
}

.status-failed {
  color: #e64340;
  background-color: rgba(230, 67, 64, 0.1);
}

.card-type {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}

.card-time {
  font-size: 24rpx;
  color: #999;
}

/* 详情 */
.detail-wrapper {
  padding-bottom: 180rpx;
}

.status-bar {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.status-bar.status-completed {
  background-color: rgba(7, 193, 96, 0.1);
  color: #07c160;
}

.status-bar.status-processing {
  background-color: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.status-bar.status-failed {
  background-color: rgba(230, 67, 64, 0.1);
  color: #e64340;
}

.detail-card {
  background-color: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.detail-meta {
  display: flex;
  align-items: center;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
  margin-right: 24rpx;
}

.card-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.detail-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.detail-video {
  width: 100%;
  border-radius: 12rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
}

/* 操作按钮 */
.action-btns {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  margin: 0 8rpx;
  border: none;
}

.copy-btn {
  background-color: #f5f5f5;
  color: #666;
}

.share-btn {
  background-color: #07c160;
  color: #fff;
}

.publish-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 加载和空状态 */
.loading-box,
.empty-box {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.loading-text,
.empty-text {
  font-size: 28rpx;
  color: #999;
}
