.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 32rpx;
}

/* 状态区域 */
.status-section {
  margin-bottom: 32rpx;
}

.status-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.status-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.status-indicator {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}

.status-indicator.idle {
  background-color: #f0f0f0;
}

.status-indicator.scanning {
  background-color: rgba(102, 126, 234, 0.1);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.6; }
  100% { opacity: 1; }
}

.status-text {
  font-size: 30rpx;
  color: #666;
}

.status-indicator.scanning .status-text {
  color: #667eea;
  font-weight: bold;
}

/* 控制区域 */
.control-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.control-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
}

.start-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.stop-btn {
  background-color: #e64340;
  color: #fff;
}

.test-btn {
  background-color: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
}

/* 信息卡片 */
.info-section,
.result-section,
.help-section {
  margin-bottom: 32rpx;
}

.info-card,
.result-card,
.help-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.info-title,
.result-title,
.help-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  margin-right: 16rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 结果状态 */
.result-status {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.result-status.success {
  background-color: rgba(7, 193, 96, 0.1);
  color: #07c160;
}

.result-status.error {
  background-color: rgba(230, 67, 64, 0.1);
  color: #e64340;
}

.result-item {
  display: flex;
  margin-bottom: 8rpx;
}

.result-label {
  font-size: 26rpx;
  color: #999;
  margin-right: 16rpx;
}

.result-value {
  font-size: 26rpx;
  color: #333;
}

/* 帮助 */
.help-content {
  display: flex;
  flex-direction: column;
}

.help-item {
  font-size: 26rpx;
  color: #666;
  line-height: 2;
}
